DATABASE_URL=postgresql://user:password@localhost:5432/cv_builder
# Generate your own: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_your_own_random_64_hex_secret
NVIDIA_API_KEY=replace_with_your_nvidia_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=qwen/qwen3-next-80b-a3b-instruct

PORT=3000
# Public base URL of this deployment (used to build password-reset links)
APP_BASE_URL=http://localhost:3000
# Allowed browser origin for the API (same host that serves the SPA)
CORS_ORIGIN=http://localhost:3000

# Email delivery (Resend). Without a key, reset emails are NOT sent;
# in development the reset link is returned in the API response instead.
RESEND_API_KEY=
RESEND_FROM="CV Builder Platform" <no-reply@cvbuilder.com>

# 'production' disables dev-only conveniences (e.g. dev reset links)
NODE_ENV=development

# Set to 'false' ONLY for databases with self-signed TLS certificates
PGSSLSTRICT=true
